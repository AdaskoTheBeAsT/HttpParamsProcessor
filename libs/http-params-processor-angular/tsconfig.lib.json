{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": "../..",
    "composite": true,
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": [],
    "rootDir": "."
  },
  "include": ["src/**/*.ts"],
  "references": [{ "path": "../http-params-processor-core/tsconfig.lib.json" }],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  },
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts"]
}
